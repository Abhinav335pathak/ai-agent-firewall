# Copy to .env for LOCAL development:   cp .env.example .env
#
# These values are deliberately weak demo defaults.
# On the server, scripts/init-env.sh generates strong random secrets automatically,
# so you never put production secrets in git or in Terraform state.

# Docker Hub namespace for images. Leave empty locally (images are built on your machine).
DOCKERHUB_USERNAME=
IMAGE_TAG=latest
HTTP_PORT=80

# Database passwords
COMPANY_DB_PASSWORD=dev-company-db-pass
AUDIT_DB_PASSWORD=dev-audit-db-pass

# Credential that only the firewall holds (company API rejects everyone else)
INTERNAL_API_TOKEN=dev-internal-token

# Needed to approve/reject requests, and to call /admin/reset
ADMIN_TOKEN=demo-admin-token
AGENT_TOKEN=demo-agent-token
METRICS_TOKEN=demo-metrics-token
# Optional JSON maps for individual identities and scopes (keep secrets out of Git):
# REVIEWER_TOKENS={"reviewer-name":"unique-long-token"}
# AGENT_CREDENTIALS={"reader":{"token":"unique-agent-token","actions":["execute_sql"],"tables":["customers"]}}

# Human-in-the-loop timeout; no decision within this time = auto-deny
APPROVAL_TIMEOUT_MS=30000

# Demo convenience: lets /admin/reset also wipe the audit trail. Set false for real use.
ALLOW_AUDIT_RESET=true

# ---- Optional monitoring (Prometheus + Grafana) ----
# COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml
# GRAFANA_PASSWORD=change-me
